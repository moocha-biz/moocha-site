# Copy to .env.local (gitignored) for local dev. Vite loads .env.local over
# .env, so this overrides the prod values in .env without touching them.
#
# `./scripts/dev-up.sh` keeps VITE_SUPABASE_URL/VITE_SUPABASE_ANON_KEY in
# sync with your local Supabase stack automatically - you only need to fill
# in the Stripe key by hand. See README.md's "Local development" section.

VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# Stripe test-mode publishable key: https://dashboard.stripe.com/test/apikeys
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME

VITE_TELEGRAM_BOT_USERNAME=mooochabot
